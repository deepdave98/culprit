{
  "name": "culprit-css",
  "version": "0.1.0",
  "description": "Test which CSS changes made an element look different.",
  "type": "module",
  "license": "MIT",
  "author": "deepdave98",
  "bin": { "culprit": "dist/cli.js" },
  "files": ["dist", "docs", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "fixtures": "node --import tsx fixtures/server.ts",
    "demo": "node --import tsx scripts/demo.ts"
  },
  "dependencies": { "playwright": "1.64.0", "pngjs": "7.0.0", "postcss": "8.5.30" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/pngjs": "^6.0.5", "tsx": "4.23.15", "typescript": "7.0.2" }
}
